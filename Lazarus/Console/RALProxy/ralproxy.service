# Unidade do systemd para o RALProxy (Linux).
#   sudo cp ralproxy /usr/local/bin/ && sudo mkdir -p /etc/ralproxy
#   sudo cp ralproxy.conf /etc/ralproxy/ && sudo cp ralproxy.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now ralproxy
#   sudo systemctl reload ralproxy     # recarrega sem cortar conexoes (SIGHUP)
[Unit]
Description=RALProxy - balanceador do PascalRAL
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/etc/ralproxy
ExecStartPre=/usr/local/bin/ralproxy -t -c /etc/ralproxy/ralproxy.conf
ExecStart=/usr/local/bin/ralproxy -c /etc/ralproxy/ralproxy.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
# portas abaixo de 1024 sem ser root
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
